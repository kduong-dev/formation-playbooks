# Generated by formation-playbooks ({{ project }}). Do not edit by hand.
# Source: {{ project }}/services.yml, shared/templates/services.sh.j2
#
# What shared/scripts/run-services.sh needs to run a service on the host:
# where its Go module lives (relative to formation-playbooks' parent), the
# API hosts its proxy route matches, and each service's path prefix and cmd.

BACKEND_DIR={{ backend_dir }}
API_DOMAINS=({{ api_domain }} {{ local_api_domain }})
# <service> <path_prefix> <cmd dir>
SERVICES=(
{% for key, cfg in services.items() %}
{% set name = key | replace('_', '-') %}
    "{{ name }} {{ cfg.path_prefix }} cmd/{{ cfg.cmd | default(name) }}"
{% endfor %}
)
