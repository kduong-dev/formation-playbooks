# Generated by formation-playbooks ({{ project }}). Do not edit by hand.
# Source: {{ project }}/services.yml, {{ project }}/resources.yml, shared/templates/docker-compose.yml.j2

services:
  # File-only provider: routes are generated from services.yml at render time
  # into traefik-dynamic/static.yml. No Docker API access needed.
  traefik:
    image: traefik:v3.1
    command:
      - "--providers.file.directory=/etc/traefik/dynamic"
      - "--providers.file.watch=true"
      - "--entrypoints.web.address=:80"
    ports:
      - "80:80"
    volumes:
      - ./traefik-dynamic:/etc/traefik/dynamic:ro
    extra_hosts:
      - "host.docker.internal:host-gateway"
    restart: unless-stopped
{% for res_name in extra_compose_services | default([]) %}
{% set res = lookup('vars', res_name) %}

  {{ res_name }}:
    image: {{ res.compose.image }}
{% if res.compose.environment is defined %}
    environment:
{% for k, v in res.compose.environment.items() %}
      {{ k }}: {{ v }}
{% endfor %}
{% endif %}
{% if res.compose.ports is defined %}
    ports:
{% for port in res.compose.ports %}
      - '{{ port }}'
{% endfor %}
{% endif %}
{% if res.compose.healthcheck is defined %}
    healthcheck:
      test: {{ res.compose.healthcheck.test | to_json }}
      interval: {{ res.compose.healthcheck.interval }}
      timeout: {{ res.compose.healthcheck.timeout }}
      retries: {{ res.compose.healthcheck.retries }}
{% if res.compose.healthcheck.start_period is defined %}
      start_period: {{ res.compose.healthcheck.start_period }}
{% endif %}
{% endif %}
{% if res.compose.volumes is defined %}
    volumes:
{% for vol in res.compose.volumes %}
      - {{ vol }}
{% endfor %}
{% endif %}
    mem_limit: {{ res.compose.memory.limit }}
    mem_reservation: {{ res.compose.memory.reservation }}
    restart: unless-stopped
{% endfor %}

  frontend:
    image: {{ project }}-frontend:latest
    build:
      context: ../../..
      dockerfile: ./formation-playbooks/projects/{{ project }}/frontend/Dockerfile
{% if frontend_env_file | default(false) %}
    env_file:
      - ./frontend/.env
{% endif %}
    expose:
      - "{{ frontend.compose.container_port }}"
    depends_on:
{% for dep in frontend.compose.depends_on %}
      {{ dep.name }}:
        condition: {{ dep.condition | default('service_started') }}
{% endfor %}
    mem_limit: {{ frontend.compose.memory.limit }}
    mem_reservation: {{ frontend.compose.memory.reservation }}
    restart: unless-stopped
{% for key, cfg in services.items() %}
{% set name = key | replace('_', '-') %}

  {{ name }}:
    image: {{ project }}-{{ name }}:latest
    build:
      context: ../../..
      dockerfile: ./formation-playbooks/projects/{{ project }}/backend/Dockerfile
      args:
        SERVICE: {{ name }}
        PORT: {{ cfg.container.port }}
    env_file:
      - ./backend/{{ name }}/.env
    expose:
      - "{{ cfg.container.port }}"
{% if cfg.compose.depends_on is defined %}
    depends_on:
{% for dep in cfg.compose.depends_on %}
      {{ dep.name }}:
        condition: {{ dep.condition | default('service_started') }}
{% endfor %}
{% endif %}
{% if cfg.compose.volumes is defined %}
    volumes:
{% for vol in cfg.compose.volumes %}
      - {{ vol }}
{% endfor %}
{% endif %}
    mem_limit: {{ cfg.compose.memory.limit }}
    mem_reservation: {{ cfg.compose.memory.reservation }}
    restart: unless-stopped
{% endfor %}

networks:
  default:
    driver: bridge
{% if named_volumes | default([]) %}

volumes:
{% for vol in named_volumes %}
  {{ vol }}:
{% endfor %}
{% endif %}
